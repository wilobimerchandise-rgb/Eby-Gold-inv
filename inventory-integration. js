// ============================================
// INVENTORY-INVOICE INTEGRATION
// Connects Add Items table with Inventory DB
// ============================================

(function() {
    'use strict';

    // ============================================
    // WAIT FOR INVENTORY
    // ============================================
    function waitForInventory(retries = 30) {
        return new Promise((resolve, reject) => {
            if (window.__inventory && window.__inventory.manager) {
                resolve(window.__inventory);
                return;
            }

            let attempts = 0;
            const interval = setInterval(() => {
                attempts++;
                if (window.__inventory && window.__inventory.manager) {
                    clearInterval(interval);
                    resolve(window.__inventory);
                } else if (attempts >= retries) {
                    clearInterval(interval);
                    reject(new Error('Inventory module not loaded after ' + retries + ' attempts'));
                }
            }, 500);
        });
    }

    // ============================================
    // MAIN INTEGRATION CLASS
    // ============================================
    class InvoiceInventoryIntegration {
        constructor() {
            this.inventory = null;
            this.customerData = {};
            this.invoiceNumber = this.generateInvoiceNumber();
            this.initialized = false;
            this.products = [];
        }

        generateInvoiceNumber() {
            const prefix = 'EGS-INV';
            const date = new Date();
            const dateStr = date.getFullYear() + 
                           String(date.getMonth() + 1).padStart(2, '0') + 
                           String(date.getDate()).padStart(2, '0');
            const random = Math.floor(Math.random() * 1000000).toString().padStart(6, '0');
            return `${prefix}-${dateStr}-${random}`;
        }

        async init() {
            try {
                this.inventory = await waitForInventory();
                this.initialized = true;
                
                // Load products
                await this.loadProducts();
                
                console.log('✅ Inventory integration ready');
                console.log('📦 Products loaded:', this.products.length);
                
                // Setup the invoice form
                this.setupInvoiceForm();
                this.setupCustomerSection();
                this.setupInvoiceActions();
                
                // Auto-fill invoice number
                this.updateInvoiceNumber();
                
                // Load saved customer data
                this.loadCustomerData();
                
                return true;
            } catch (error) {
                console.error('❌ Integration init failed:', error);
                return false;
            }
        }

        async loadProducts() {
            try {
                this.products = await this.inventory.manager.getAllProducts();
                console.log('📦 Loaded', this.products.length, 'products');
            } catch (error) {
                console.error('Failed to load products:', error);
                this.products = [];
            }
        }

        // ============================================
        // INVOICE FORM SETUP
        // ============================================
        setupInvoiceForm() {
            // Find the Add Items section
            const addItemsSection = this.findSection('Add Items');
            if (!addItemsSection) {
                console.warn('⚠️ "Add Items" section not found');
                return;
            }

            // Find the table
            let table = addItemsSection.querySelector('table');
            if (!table) {
                console.warn('⚠️ Table not found in Add Items section');
                return;
            }

            // Check if already enhanced
            if (table.dataset.inventoryEnhanced === 'true') {
                console.log('✅ Table already enhanced');
                return;
            }

            // Enhance the table
            this.enhanceTable(table);
            table.dataset.inventoryEnhanced = 'true';
            
            console.log('✅ Invoice table enhanced');
        }

        findSection(title) {
            // Try to find by heading
            const headings = document.querySelectorAll('h2, h3, h4, .section-title');
            for (const heading of headings) {
                if (heading.textContent.trim() === title) {
                    return heading.parentElement || heading;
                }
            }
            
            // Try to find by text content
            const elements = document.querySelectorAll('div, section, .section');
            for (const el of elements) {
                if (el.textContent.includes(title) && el.children.length > 0) {
                    return el;
                }
            }
            
            return null;
        }

        enhanceTable(table) {
            // Get the tbody
            let tbody = table.querySelector('tbody');
            if (!tbody) {
                tbody = document.createElement('tbody');
                table.appendChild(tbody);
            }

            // Check if there's already a header
            let thead = table.querySelector('thead');
            if (!thead) {
                thead = document.createElement('thead');
                const headerRow = document.createElement('tr');
                const headers = ['S/N', 'Items', 'Qty', 'Rate (₦)', 'Total (₦)', 'Action'];
                headers.forEach(text => {
                    const th = document.createElement('th');
                    th.textContent = text;
                    headerRow.appendChild(th);
                });
                thead.appendChild(headerRow);
                table.prepend(thead);
            }

            // Add a sample row if empty
            if (tbody.children.length === 0) {
                this.addItemRow(tbody);
            }

            // Store reference
            this.tbody = tbody;
            this.table = table;

            // Setup row events (delegation)
            tbody.addEventListener('input', (e) => {
                const row = e.target.closest('.item-row');
                if (!row) return;

                const nameInput = row.querySelector('.item-name');
                const qtyInput = row.querySelector('.item-qty');
                const rateInput = row.querySelector('.item-rate');

                if (e.target === nameInput) {
                    this.handleProductSearch(nameInput);
                }

                if (e.target === qtyInput || e.target === rateInput) {
                    this.calculateRowTotal(row);
                    this.updateTotals();
                }
            });

            tbody.addEventListener('click', (e) => {
                if (e.target.classList.contains('remove-item') || e.target.closest('.remove-item')) {
                    const btn = e.target.closest('.remove-item');
                    const row = btn.closest('.item-row');
                    if (this.tbody.children.length > 1) {
                        row.remove();
                        this.updateRowNumbers();
                        this.updateTotals();
                    } else {
                        alert('Cannot remove the last row. Clear the fields instead.');
                    }
                }
            });

            // Add "Add Item" button if not exists
            const container = table.parentElement;
            let addBtn = container.querySelector('.add-item-btn');
            if (!addBtn) {
                addBtn = document.createElement('button');
                addBtn.textContent = '➕ Add Item';
                addBtn.className = 'add-item-btn';
                addBtn.style.cssText = `
                    margin: 10px 0;
                    padding: 8px 16px;
                    background: #28a745;
                    color: white;
                    border: none;
                    border-radius: 4px;
                    cursor: pointer;
                `;
                container.appendChild(addBtn);
            }

            addBtn.addEventListener('click', () => {
                this.addItemRow(this.tbody);
            });

            // Add summary section
            let summary = document.getElementById('invoice-summary');
            if (!summary) {
                summary = document.createElement('div');
                summary.id = 'invoice-summary';
                summary.style.cssText = `
                    margin: 15px 0;
                    padding: 15px;
                    background: #f8f9fa;
                    border-radius: 8px;
                    border-left: 4px solid #007bff;
                `;
                summary.innerHTML = `
                    <div style="display:flex;justify-content:space-between;flex-wrap:wrap;gap:10px;">
                        <span><strong>Subtotal:</strong> <span id="subtotal">₦0.00</span></span>
                        <span><strong>Total:</strong> <span id="grand-total">₦0.00</span></span>
                        <span><strong>Items:</strong> <span id="item-count">0</span></span>
                    </div>
                `;
                container.appendChild(summary);
            }

            this.summary = summary;
        }

        addItemRow(tbody, data = null) {
            const rowCount = tbody.children.length + 1;
            
            const row = document.createElement('tr');
            row.className = 'item-row';
            row.innerHTML = `
                <td class="sn">${rowCount}</td>
                <td style="position:relative;">
                    <input type="text" class="item-name" placeholder="Search product..." autocomplete="off" style="width:100%;padding:6px;border:1px solid #ddd;border-radius:4px;">
                    <div class="autocomplete-list" style="display:none;position:absolute;background:white;border:1px solid #ddd;border-radius:4px;max-height:200px;overflow-y:auto;z-index:1000;min-width:200px;box-shadow:0 4px 8px rgba(0,0,0,0.1);"></div>
                </td>
                <td><input type="number" class="item-qty" value="${data ? data.qty : 1}" min="1" style="width:70px;padding:6px;border:1px solid #ddd;border-radius:4px;"></td>
                <td><input type="number" class="item-rate" step="0.01" value="${data ? data.rate : 0}" style="width:100px;padding:6px;border:1px solid #ddd;border-radius:4px;"></td>
                <td class="item-total">₦0.00</td>
                <td><button class="remove-item" style="color:red;background:none;border:none;cursor:pointer;font-size:18px;">✕</button></td>
            `;

            tbody.appendChild(row);

            // If data provided, set values
            if (data) {
                const nameInput = row.querySelector('.item-name');
                const qtyInput = row.querySelector('.item-qty');
                const rateInput = row.querySelector('.item-rate');
                if (data.name) nameInput.value = data.name;
                if (data.qty) qtyInput.value = data.qty;
                if (data.rate) rateInput.value = data.rate;
                this.calculateRowTotal(row);
            }

            this.updateRowNumbers();
            this.updateTotals();

            // Focus on name input
            setTimeout(() => {
                row.querySelector('.item-name').focus();
            }, 100);

            return row;
        }

        // ============================================
        // PRODUCT SEARCH / AUTOCOMPLETE
        // ============================================
        async handleProductSearch(input) {
            const container = input.parentElement;
            let list = container.querySelector('.autocomplete-list');
            
            if (!list) {
                list = document.createElement('div');
                list.className = 'autocomplete-list';
                list.style.cssText = `
                    position: absolute;
                    background: white;
                    border: 1px solid #ddd;
                    border-radius: 4px;
                    max-height: 200px;
                    overflow-y: auto;
                    z-index: 1000;
                    min-width: 200px;
                    box-shadow: 0 4px 8px rgba(0,0,0,0.1);
                `;
                list.style.display = 'none';
                container.style.position = 'relative';
                container.appendChild(list);
            }

            const query = input.value.trim();
            
            if (query.length < 1) {
                list.style.display = 'none';
                return;
            }

            try {
                // Search products
                const products = await this.inventory.manager.searchProducts(query);
                
                if (products.length === 0) {
                    list.innerHTML = `
                        <div style="padding:8px;color:#999;">No products found</div>
                        <div style="padding:8px;border-top:1px solid #eee;">
                            <button onclick="addNewProductFromInvoice('${query}')" 
                                    style="background:#28a745;color:white;border:none;padding:4px 12px;border-radius:4px;cursor:pointer;">
                                ➕ Create "${query}"
                            </button>
                        </div>
                    `;
                    list.style.display = 'block';
                    return;
                }

                list.innerHTML = '';
                products.forEach(product => {
                    const item = document.createElement('div');
                    item.style.cssText = `
                        padding: 8px 12px;
                        cursor: pointer;
                        border-bottom: 1px solid #f0f0f0;
                        display: flex;
                        justify-content: space-between;
                        align-items: center;
                    `;
                    
                    const priceNGN = (product.unitPriceUSD || 0) * 1600;
                    const stock = product.quantity || 0;
                    const stockColor = stock < 10 ? '#dc3545' : '#28a745';
                    
                    item.innerHTML = `
                        <span><strong>${product.name}</strong></span>
                        <span style="color:#666;">₦${priceNGN.toLocaleString()}</span>
                        <span style="font-size:12px;color:${stockColor};">Stock: ${stock}</span>
                    `;
                    
                    item.addEventListener('click', () => {
                        this.selectProduct(input, product);
                        list.style.display = 'none';
                    });
                    
                    item.addEventListener('mouseenter', () => {
                        item.style.background = '#f0f0f0';
                    });
                    item.addEventListener('mouseleave', () => {
                        item.style.background = 'white';
                    });
                    
                    list.appendChild(item);
                });
                list.style.display = 'block';

            } catch (error) {
                console.error('Product search failed:', error);
            }
        }

        selectProduct(input, product) {
            const row = input.closest('.item-row');
            const rateInput = row.querySelector('.item-rate');
            const qtyInput = row.querySelector('.item-qty');
            
            // Set product name
            input.value = product.name;
            input.dataset.productId = product.id;
            
            // Set rate (convert USD to NGN)
            const rateNGN = (product.unitPriceUSD || 0) * 1600;
            rateInput.value = rateNGN.toFixed(2);
            
            // Check stock availability
            const available = product.quantity || 0;
            const currentQty = parseInt(qtyInput.value) || 1;
            if (available < currentQty) {
                alert(`⚠️ Only ${available} units in stock. Adjusting quantity.`);
                qtyInput.value = Math.max(1, available);
            }
            
            // Update total
            this.calculateRowTotal(row);
            this.updateTotals();
            
            // Hide autocomplete
            const container = input.parentElement;
            const list = container.querySelector('.autocomplete-list');
            if (list) list.style.display = 'none';
        }

        // ============================================
        // CALCULATIONS
        // ============================================
        calculateRowTotal(row) {
            const qtyInput = row.querySelector('.item-qty');
            const rateInput = row.querySelector('.item-rate');
            const totalCell = row.querySelector('.item-total');
            
            const qty = parseFloat(qtyInput.value) || 0;
            const rate = parseFloat(rateInput.value) || 0;
            const total = qty * rate;
            
            totalCell.textContent = `₦${total.toLocaleString('en-US', {
                minimumFractionDigits: 2, 
                maximumFractionDigits: 2
            })}`;
            
            return total;
        }

        updateTotals() {
            let subtotal = 0;
            let itemCount = 0;
            
            this.tbody.querySelectorAll('.item-row').forEach(row => {
                const qtyInput = row.querySelector('.item-qty');
                const rateInput = row.querySelector('.item-rate');
                
                const qty = parseFloat(qtyInput.value) || 0;
                const rate = parseFloat(rateInput.value) || 0;
                const total = qty * rate;
                
                if (total > 0) {
                    subtotal += total;
                    itemCount++;
                }
            });
            
            // Update summary
            const subtotalEl = document.getElementById('subtotal');
            const grandTotalEl = document.getElementById('grand-total');
            const itemCountEl = document.getElementById('item-count');
            
            if (subtotalEl) {
                subtotalEl.textContent = `₦${subtotal.toLocaleString('en-US', {
                    minimumFractionDigits: 2, 
                    maximumFractionDigits: 2
                })}`;
            }
            if (grandTotalEl) {
                grandTotalEl.textContent = `₦${subtotal.toLocaleString('en-US', {
                    minimumFractionDigits: 2, 
                    maximumFractionDigits: 2
                })}`;
            }
            if (itemCountEl) {
                itemCountEl.textContent = itemCount;
            }
        }

        updateRowNumbers() {
            this.tbody.querySelectorAll('.item-row').forEach((row, index) => {
                const snCell = row.querySelector('.sn');
                if (snCell) snCell.textContent = index + 1;
            });
        }

        updateInvoiceNumber() {
            const docNoElements = document.querySelectorAll('*');
            for (const el of docNoElements) {
                const text = el.textContent || '';
                if (text.includes('DOCUMENT NO:')) {
                    el.textContent = text.replace(/#?[\w-]+/, `#${this.invoiceNumber}`);
                    break;
                }
            }
        }

        // ============================================
        // INVOICE DATA
        // ============================================
        getInvoiceData() {
            const items = [];
            
            this.tbody.querySelectorAll('.item-row').forEach(row => {
                const nameInput = row.querySelector('.item-name');
                const qtyInput = row.querySelector('.item-qty');
                const rateInput = row.querySelector('.item-rate');
                
                const name = nameInput.value.trim();
                const qty = parseFloat(qtyInput.value) || 0;
                const rate = parseFloat(rateInput.value) || 0;
                
                if (name && qty > 0) {
                    items.push({
                        name: name,
                        qty: qty,
                        rate: rate,
                        total: qty * rate,
                        productId: nameInput.dataset.productId || null
                    });
                }
            });
            
            return {
                invoiceNumber: this.invoiceNumber,
                date: new Date().toISOString().split('T')[0],
                customer: this.customerData,
                items: items,
                subtotal: items.reduce((sum, item) => sum + item.total, 0),
                total: items.reduce((sum, item) => sum + item.total, 0),
                currency: 'NGN'
            };
        }

        // ============================================
        // CUSTOMER SECTION
        // ============================================
        setupCustomerSection() {
            const customerSection = this.findSection('Customer Details');
            if (!customerSection) {
                console.warn('⚠️ "Customer Details" section not found');
                return;
            }

            // Check if already enhanced
            if (customerSection.querySelector('#customer-db-integration')) return;
            
            const wrapper = document.createElement('div');
            wrapper.id = 'customer-db-integration';
            wrapper.style.cssText = 'margin: 10px 0; padding: 15px; background: #f8f9fa; border-radius: 8px;';
            
            wrapper.innerHTML = `
                <div style="display:flex;flex-wrap:wrap;gap:10px;align-items:end;">
                    <div style="flex:2;min-width:150px;">
                        <label style="display:block;font-size:12px;color:#666;margin-bottom:3px;">Customer Name</label>
                        <input type="text" id="customer-name" class="customer-input" placeholder="Search or enter customer..." style="width:100%;padding:8px;border:1px solid #ddd;border-radius:4px;" autocomplete="off">
                        <div id="customer-autocomplete" style="display:none;position:absolute;background:white;border:1px solid #ddd;border-radius:4px;max-height:150px;overflow-y:auto;z-index:1000;min-width:200px;box-shadow:0 4px 8px rgba(0,0,0,0.1);"></div>
                    </div>
                    <div style="flex:1;min-width:120px;">
                        <label style="display:block;font-size:12px;color:#666;margin-bottom:3px;">Phone</label>
                        <input type="text" id="customer-phone" class="customer-input" style="width:100%;padding:8px;border:1px solid #ddd;border-radius:4px;">
                    </div>
                    <div style="flex:2;min-width:150px;">
                        <label style="display:block;font-size:12px;color:#666;margin-bottom:3px;">Address</label>
                        <input type="text" id="customer-address" class="customer-input" style="width:100%;padding:8px;border:1px solid #ddd;border-radius:4px;">
                    </div>
                    <div>
                        <button id="save-customer-btn" style="padding:8px 16px;background:#007bff;color:white;border:none;border-radius:4px;cursor:pointer;">💾 Save Customer</button>
                    </div>
                </div>
                <div id="customer-list" style="margin-top:10px;font-size:13px;color:#666;"></div>
            `;
            
            customerSection.appendChild(wrapper);
            
            // Setup customer events
            this.setupCustomerEvents();
        }

        setupCustomerEvents() {
            const nameInput = document.getElementById('customer-name');
            const phoneInput = document.getElementById('customer-phone');
            const addressInput = document.getElementById('customer-address');
            const saveBtn = document.getElementById('save-customer-btn');
            const autocompleteContainer = document.getElementById('customer-autocomplete');
            
            if (!nameInput) return;
            
            // Make container position relative for autocomplete
            const container = nameInput.parentElement;
            container.style.position = 'relative';
            
            // Search customers on input
            let searchTimeout;
            nameInput.addEventListener('input', (e) => {
                clearTimeout(searchTimeout);
                searchTimeout = setTimeout(() => {
                    this.searchCustomers(e.target.value, autocompleteContainer);
                }, 300);
            });
            
            // Save customer
            saveBtn.addEventListener('click', () => {
                this.saveCustomer({
                    name: nameInput.value.trim(),
                    phone: phoneInput.value.trim(),
                    address: addressInput.value.trim()
                });
            });
            
            // Click outside to hide autocomplete
            document.addEventListener('click', (e) => {
                if (!e.target.closest('#customer-name') && !e.target.closest('#customer-autocomplete')) {
                    autocompleteContainer.style.display = 'none';
                }
            });
        }

        async searchCustomers(query, container) {
            if (query.length < 1) {
                container.style.display = 'none';
                return;
            }
            
            try {
                const customers = await this.inventory.manager.getCustomers(query);
                
                if (customers.length === 0) {
                    container.innerHTML = `<div style="padding:8px;color:#999;">No customers found. Press Save to add.</div>`;
                    container.style.display = 'block';
                    return;
                }
                
                container.innerHTML = '';
                customers.forEach(customer => {
                    const item = document.createElement('div');
                    item.style.cssText = 'padding:8px 12px;cursor:pointer;border-bottom:1px solid #f0f0f0;';
                    item.innerHTML = `<strong>${customer.name}</strong><br><small style="color:#666;">${customer.phone || ''} ${customer.address || ''}</small>`;
                    
                    item.addEventListener('click', () => {
                        this.selectCustomer(customer);
                        container.style.display = 'none';
                    });
                    
                    container.appendChild(item);
                });
                container.style.display = 'block';
                
            } catch (error) {
                console.error('Customer search failed:', error);
            }
        }

        selectCustomer(customer) {
            document.getElementById('customer-name').value = customer.name;
            document.getElementById('customer-phone').value = customer.phone || '';
            document.getElementById('customer-address').value = customer.address || '';
            this.customerData = customer;
        }

        async saveCustomer(data) {
            if (!data.name) {
                alert('Please enter a customer name');
                return;
            }
            
            try {
                const saved = await this.inventory.manager.saveCustomer(data);
                alert(`✅ Customer "${data.name}" saved successfully!`);
                this.customerData = saved;
                this.loadCustomerData();
            } catch (error) {
                alert('❌ Failed to save customer: ' + error.message);
            }
        }

        async loadCustomerData() {
            try {
                const customers = await this.inventory.manager.getCustomers();
                const listEl = document.getElementById('customer-list');
                if (listEl && customers.length > 0) {
                    listEl.innerHTML = `📋 Recent customers: ${customers.slice(0, 5).map(c => c.name).join(', ')}`;
                }
            } catch (error) {
                console.error('Load customer data failed:', error);
            }
        }

        // ============================================
        // INVOICE ACTIONS (Create / Save)
        // ============================================
        setupInvoiceActions() {
            // Find the create invoice button
            const buttons = document.querySelectorAll('button');
            let createBtn = null;
            
            for (const btn of buttons) {
                const text = btn.textContent || '';
                if (/create|save|generate|invoice|print|submit/i.test(text)) {
                    createBtn = btn;
                    break;
                }
            }
            
            if (createBtn) {
                const originalClick = createBtn.onclick;
                createBtn.addEventListener('click', async (e) => {
                    await this.validateBeforeInvoice(e, originalClick);
                });
                console.log('✅ Invoice action button enhanced');
            } else {
                console.warn('⚠️ No create/save button found');
            }
        }

        async validateBeforeInvoice(e, originalHandler) {
            const invoiceData = this.getInvoiceData();
            
            if (invoiceData.items.length === 0) {
                alert('Please add at least one item to the invoice.');
                e.preventDefault();
                return false;
            }
            
            // Check stock for each item
            let hasStockIssue = false;
            const stockResults = [];
            
            for (const item of invoiceData.items) {
                let product = await this.inventory.manager.getProductByName(item.name);
                
                if (!product) {
                    // Product not in inventory - ask to add
                    const addToInventory = confirm(`"${item.name}" is not in inventory. Would you like to add it now?`);
                    if (addToInventory) {
                        try {
                            const newId = await this.inventory.manager.createProduct({
                                name: item.name,
                                unitPriceUSD: item.rate / 1600,
                                initialStock: 0
                            });
                            product = await this.inventory.manager.getProductWithStock(newId);
                            stockResults.push({ item: item.name, status: 'created' });
                        } catch (error) {
                            alert(`❌ Failed to add product: ${error.message}`);
                            hasStockIssue = true;
                        }
                    } else {
                        hasStockIssue = true;
                    }
                } else if (product.quantity < item.qty) {
                    alert(`⚠️ Insufficient stock for "${item.name}". Available: ${product.quantity}, Requested: ${item.qty}`);
                    hasStockIssue = true;
                } else {
                    stockResults.push({ item: item.name, status: 'ok' });
                }
            }
            
            if (hasStockIssue) {
                e.preventDefault();
                return false;
            }
            
            // Deduct stock
            try {
                const results = await this.inventory.manager.deductStockForInvoice(
                    this.invoiceNumber, 
                    invoiceData.items
                );
                
                let summary = '📊 Stock Deduction Results:\n\n';
                results.forEach(r => {
                    if (r.status === 'deducted') {
                        summary += `✅ ${r.productName}: ${r.remaining} remaining\n`;
                    } else if (r.status === 'created') {
                        summary += `🆕 ${r.productName}: Added to inventory (0 stock)\n`;
                    } else {
                        summary += `❌ ${r.productName}: ${r.error}\n`;
                    }
                });
                alert(summary);
                
            } catch (error) {
                alert('❌ Stock deduction failed: ' + error.message);
                e.preventDefault();
                return false;
            }
            
            // If all checks pass, proceed with invoice creation
            if (originalHandler) {
                // Store invoice data for the original handler
                window.__invoiceData = invoiceData;
            }
            
            return true;
        }
    }

    // ============================================
    // GLOBAL HELPER: Add product from invoice
    // ============================================
    window.addNewProductFromInvoice = async function(name) {
        if (!name || !window.__inventory) return;
        
        try {
            const manager = window.__inventory.manager;
            await manager.createProduct({
                name: name.trim(),
                unitPriceUSD: 0,
                initialStock: 0
            });
            alert(`✅ "${name}" added to inventory! Please refresh and search again.`);
            
            // Reload products
            if (window.__invoiceIntegration) {
                await window.__invoiceIntegration.loadProducts();
            }
        } catch (error) {
            alert('❌ Failed to add product: ' + error.message);
        }
    };

    // ============================================
    // INITIALIZATION
    // ============================================
    let integrationInstance = null;

    async function initIntegration() {
        try {
            // Wait for DOM
            await new Promise(resolve => {
                if (document.readyState === 'complete') resolve();
                else window.addEventListener('load', resolve);
            });
            
            // Wait for inventory
            await waitForInventory();
            
            // Initialize integration
            integrationInstance = new InvoiceInventoryIntegration();
            await integrationInstance.init();
            
            console.log('✅ Invoice-Inventory integration ready!');
            window.__invoiceIntegration = integrationInstance;
            
            // Dispatch event
            document.dispatchEvent(new CustomEvent('integration-ready', {
                detail: { integration: integrationInstance }
            }));
            
        } catch (error) {
            console.error('❌ Integration init failed:', error);
        }
    }

    // Auto-init with retry
    let initAttempts = 0;
    const maxAttempts = 5;

    function tryInit() {
        initAttempts++;
        if (initAttempts > maxAttempts) {
            console.error('❌ Failed to initialize integration after', maxAttempts, 'attempts');
            return;
        }
        
        if (document.readyState === 'complete' || document.readyState === 'interactive') {
            initIntegration();
        } else {
            document.addEventListener('DOMContentLoaded', initIntegration);
        }
    }

    tryInit();

})();
